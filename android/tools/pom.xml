<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build-time tool dependencies for the no-SDK APK pipeline (see ../build_apk.py).
  Resolved from Maven Central with:  mvn -q dependency:copy-dependencies -DoutputDirectory=lib
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.midtownstrike</groupId>
  <artifactId>apk-build-tools</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>
  <dependencies>
    <!-- Android framework API stubs: compile classpath only, never packaged -->
    <dependency>
      <groupId>com.google.android</groupId>
      <artifactId>android</artifactId>
      <version>4.1.1.4</version>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- AOSP dx: .class -> classes.dex -->
    <dependency>
      <groupId>com.jakewharton.android.repackaged</groupId>
      <artifactId>dalvik-dx</artifactId>
      <version>16.0.1</version>
    </dependency>
    <!-- Google's APK signing library (v1 + v2 signature schemes) -->
    <dependency>
      <groupId>com.android.tools.build</groupId>
      <artifactId>apksig</artifactId>
      <version>2.3.0</version>
    </dependency>
  </dependencies>
</project>
